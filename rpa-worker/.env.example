# Required. HTTPS is enforced outside loopback by default.
API_BASE_URL=https://example.com
# Development only: allow plain HTTP to a trusted non-loopback host.
ALLOW_INSECURE_HTTP=false
# Required. Never commit a real worker token.
WORKER_TOKEN=replace-with-issued-token

POLL_INTERVAL=10
HTTP_TIMEOUT=30
WORK_DIR=./work

# Trusted local collector commands; blank means that platform is disabled.
# The worker passes username/password/target_date/output_path via child environment.
QIANNIU_COMMAND=python C:\\rpa\\qianniu_collector.py
WANXIANGTAI_COMMAND=python C:\\rpa\\wanxiangtai_collector.py
HUITUN_COMMAND=python C:\\rpa\\huitun_collector.py
